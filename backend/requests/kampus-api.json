			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"const list = pm.response.json();",
							"pm.test(\"Kayıtlarda _id ve createdAt var\", function () {",
							"    pm.expect(list.length).to.be.above(0);",
							"    pm.expect(list[0]).to.have.property(\"_id\");",
							"    pm.expect(list[0]).to.have.property(\"createdAt\");",
							"});",
							"// 3. istek bu _id ile çalışır",
							"if (list.length > 0) pm.collectionVariables.set(\"eventId\", list[0]._id);"
						]
					}
				}
			],
